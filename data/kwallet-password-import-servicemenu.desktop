[Desktop Entry]
Type=Service
MimeType=text/csv;application/json;
Actions=importIntoKWallet
X-KDE-Submenu=
Icon=kwalletmanager

[Desktop Action importIntoKWallet]
Name=Import passwords into KDE Wallet…
Name[de]=Passwörter ins KDE Wallet importieren…
Icon=kwalletmanager
Exec=kwallet-password-import-gui %f
