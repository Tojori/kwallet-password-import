[Desktop Entry]
Type=Application
Name=Password Import for KDE Wallet
Name[de]=Passwort-Import für KDE Wallet
GenericName=Password Import
GenericName[de]=Passwort-Import
Comment=Import passwords from Apple Passwords, browsers and password managers into KDE Wallet
Comment[de]=Passwörter aus Apple Passwörter, Browsern und Passwortmanagern ins KDE Wallet übernehmen
Exec=kwallet-password-import-gui %f
Icon=kwalletmanager
Terminal=false
Categories=Qt;KDE;Utility;Security;
MimeType=text/csv;application/json;
Keywords=password;import;kwallet;icloud;firefox;chrome;bitwarden;keepassxc;1password;proton;
Keywords[de]=Passwort;Import;KWallet;iCloud;Firefox;Chrome;Bitwarden;KeePassXC;1Password;Proton;
NoDisplay=false
