msgid ""
msgstr ""
"Project-Id-Version: kwallet-password-import\n"
"PO-Revision-Date: 2026-10-09 05:00+0200\n"
"Last-Translator: Tojori\n"
"Language-Team: German\n"
"Language: de\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=n != 1;\n"

msgid "On a Mac: open <b>Passwords</b> › <b>File</b> › <b>Export All Passwords to File…</b>. iPhone and iPad cannot export to a file."
msgstr "Am Mac: <b>Passwörter</b> öffnen › <b>Ablage</b> › <b>Alle Passwörter in Datei exportieren …</b>. iPhone und iPad können nicht in eine Datei exportieren."

msgid "In Firefox open <b>about:logins</b>, menu <b>…</b> › <b>Export Passwords…</b>."
msgstr "In Firefox <b>about:logins</b> öffnen, Menü <b>…</b> › <b>Passwörter exportieren …</b>."

msgid "In Chrome, Chromium, Edge or Brave: <b>Password Manager</b> › <b>Settings</b> › <b>Export passwords</b>."
msgstr "In Chrome, Chromium, Edge oder Brave: <b>Passwortmanager</b> › <b>Einstellungen</b> › <b>Passwörter exportieren</b>."

msgid "In Bitwarden: <b>Tools</b> › <b>Export vault</b>, format <b>.csv</b> or <b>.json</b> (not the encrypted variant)."
msgstr "In Bitwarden: <b>Werkzeuge</b> › <b>Tresor exportieren</b>, Format <b>.csv</b> oder <b>.json</b> (nicht die verschlüsselte Variante)."

msgid "In KeePassXC: <b>Database</b> › <b>Export</b> › <b>CSV File…</b>."
msgstr "In KeePassXC: <b>Datenbank</b> › <b>Exportieren</b> › <b>CSV-Datei …</b>."

msgid "In 1Password 8: <b>File</b> › <b>Export</b> › choose the account › <b>CSV</b>. Please check the preview carefully; this format is supported on a best-effort basis."
msgstr "In 1Password 8: <b>Datei</b> › <b>Exportieren</b> › Konto wählen › <b>CSV</b>. Bitte die Vorschau sorgfältig prüfen; dieses Format wird nach bestem Wissen unterstützt."

msgid "In Proton Pass: <b>Settings</b> › <b>Export</b> › <b>CSV</b>."
msgstr "In Proton Pass: <b>Einstellungen</b> › <b>Exportieren</b> › <b>CSV</b>."

msgid "A file in the FIDO <b>Credential Exchange Format</b> (CXF 1.0, JSON)."
msgstr "Eine Datei im FIDO-<b>Credential Exchange Format</b> (CXF 1.0, JSON)."

msgid "Choose the file you exported from your password manager or browser. The format is recognised automatically."
msgstr "Wähle die Datei, die du aus deinem Passwortmanager oder Browser exportiert hast. Das Format wird automatisch erkannt."

msgid "The file format was not recognised. Choose the format manually or check the file."
msgstr "Das Dateiformat wurde nicht erkannt. Wähle das Format von Hand oder prüfe die Datei."

msgid "This export is encrypted. Export it again without encryption (and delete it after the import)."
msgstr "Dieser Export ist verschlüsselt. Exportiere erneut ohne Verschlüsselung (und lösche die Datei nach dem Import)."

msgid "The file could not be read: %1"
msgstr "Die Datei konnte nicht gelesen werden: %1"

msgid "Import Passwords into KDE Wallet"
msgstr "Passwörter ins KDE Wallet importieren"

msgid "Choose the export file"
msgstr "Exportdatei wählen"

msgid "Passwords are imported once; run the import again later to bring over changes."
msgstr "Die Passwörter werden einmalig übernommen; führe den Import später erneut aus, um Änderungen zu übernehmen."

msgid "Path to the CSV or JSON file"
msgstr "Pfad zur CSV- oder JSON-Datei"

msgid "Browse…"
msgstr "Durchsuchen …"

msgid "File:"
msgstr "Datei:"

msgid "Detect automatically"
msgstr "Automatisch erkennen"

msgid "Format:"
msgstr "Format:"

msgid "The export file contains all passwords in plain text. Keep it only as long as needed; this wizard can delete it after the import."
msgstr "Die Exportdatei enthält alle Passwörter im Klartext. Bewahre sie nur so lange wie nötig auf; dieser Assistent kann sie nach dem Import löschen."

msgid "Password exports (*.csv *.json);;All files (*)"
msgstr "Passwort-Exporte (*.csv *.json);;Alle Dateien (*)"

msgid "The file cannot be opened: %1"
msgstr "Die Datei kann nicht geöffnet werden: %1"

msgid "The file is too large."
msgstr "Die Datei ist zu groß."

msgid "Recognised as %2: 1 entry."
msgid_plural "Recognised as %2: %1 entries."
msgstr[0] "Erkannt als %2: 1 Eintrag."
msgstr[1] "Erkannt als %2: %1 Einträge."

msgid "1 empty or unsupported item is skipped."
msgid_plural "%1 empty or unsupported items are skipped."
msgstr[0] "1 leerer oder nicht unterstützter Eintrag wird übersprungen."
msgstr[1] "%1 leere oder nicht unterstützte Einträge werden übersprungen."

msgid "1 passkey is not imported (passkeys are handled by kpasskey)."
msgid_plural "%1 passkeys are not imported (passkeys are handled by kpasskey)."
msgstr[0] "1 Passkey wird nicht importiert (Passkeys übernimmt kpasskey)."
msgstr[1] "%1 Passkeys werden nicht importiert (Passkeys übernimmt kpasskey)."

msgid "Choose where to store the passwords"
msgstr "Speicherort für die Passwörter wählen"

msgid "Entries are stored as \"host (user name)\" with user name, password, URL, notes and one-time code secret."
msgstr "Einträge werden als \"Host (Benutzername)\" mit Benutzername, Passwort, URL, Notizen und Einmalcode-Geheimnis gespeichert."

msgid "Wallet:"
msgstr "Wallet:"

msgid "Folder:"
msgstr "Ordner:"

msgid "Remove entries that were imported earlier from this source but no longer exist there"
msgstr "Früher aus dieser Quelle importierte Einträge entfernen, die dort nicht mehr existieren"

msgid "Only entries created by this import tool from the same source are removed. Entries you created yourself are never touched."
msgstr "Entfernt werden nur Einträge, die dieses Werkzeug aus derselben Quelle angelegt hat. Selbst angelegte Einträge bleiben immer unberührt."

msgid "Overwrite and delete the export file after a successful import"
msgstr "Exportdatei nach erfolgreichem Import überschreiben und löschen"

msgid "Enter a folder name."
msgstr "Gib einen Ordnernamen ein."

msgid "The wallet could not be opened: %1"
msgstr "Das Wallet konnte nicht geöffnet werden: %1"

msgid "Check the changes"
msgstr "Änderungen prüfen"

msgid "Nothing has been written yet. Passwords are not shown."
msgstr "Es wurde noch nichts geschrieben. Passwörter werden nicht angezeigt."

msgid "Import"
msgstr "Importieren"

msgid "Entry"
msgstr "Eintrag"

msgid "Change"
msgstr "Änderung"

msgid "new"
msgstr "neu"

msgid "changed"
msgstr "geändert"

msgid "unchanged"
msgstr "unverändert"

msgid "will be removed"
msgstr "wird entfernt"

msgid "no longer in the export (kept)"
msgstr "nicht mehr im Export (bleibt erhalten)"

msgid "Wallet <b>%1</b>, folder <b>%2</b>: %3 new, %4 changed, %5 unchanged, %6 no longer in the export."
msgstr "Wallet <b>%1</b>, Ordner <b>%2</b>: %3 neu, %4 geändert, %5 unverändert, %6 nicht mehr im Export."

msgid "%1 entries written, %2 removed."
msgstr "%1 Einträge geschrieben, %2 entfernt."

msgid "1 entry could not be written. The export file was kept."
msgid_plural "%1 entries could not be written. The export file was kept."
msgstr[0] "1 Eintrag konnte nicht geschrieben werden. Die Exportdatei wurde behalten."
msgstr[1] "%1 Einträge konnten nicht geschrieben werden. Die Exportdatei wurde behalten."

msgid "The export file was overwritten and deleted."
msgstr "Die Exportdatei wurde überschrieben und gelöscht."

msgid "The export file could not be deleted. Please delete it yourself: %1"
msgstr "Die Exportdatei konnte nicht gelöscht werden. Bitte lösche sie selbst: %1"

msgid "Remember to delete the export file; it contains all passwords in plain text."
msgstr "Denk daran, die Exportdatei zu löschen; sie enthält alle Passwörter im Klartext."

msgid "Import finished"
msgstr "Import abgeschlossen"

msgid "You can view the entries in KWalletManager."
msgstr "Die Einträge findest du im KWallet-Manager."

msgid "Open KWalletManager"
msgstr "KWallet-Manager öffnen"

msgid "Password Import for KDE Wallet"
msgstr "Passwort-Import für KDE Wallet"

msgid "Imports passwords exported from Apple Passwords, browsers and password managers into KDE Wallet."
msgstr "Übernimmt aus Apple Passwörter, Browsern und Passwortmanagern exportierte Passwörter ins KDE Wallet."

msgid "Export file to import (optional)."
msgstr "Zu importierende Exportdatei (optional)."
